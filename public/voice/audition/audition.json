 "sabinus": {
  "chosen": "eric",
  "lines": [
   {
    "id": "ch2_cl_02",
    "text": "The animal dealer's son, with the monkey. You are easy to find, young man. My name is Sabinus. I buy and sell the goods of the condemned."
   },
   {
    "id": "ch2_cl_03",
    "text": "Yesterday my boy sold you a gaming box for four coins. A mistake. It has a value of sentiment. I will give you forty for it."
   },
   {
    "id": "ch2_cl_06",
    "text": "And you must be the senator's son. I should hate to trouble either of your fathers over a toy. Think about my forty. I shall ask again."
   }
  ],
