  "lines": [
   {
    "id": "pro_in_03",
    "text": "A rematch, Aghiles. I got up right foot first, I have not sneezed all day, and my amulet is warm. The signs could not be better."
   },
   {
    "id": "bn_tit_captured_1",
    "text": "No! Not him! He was my favourite!"
   },
   {
    "id": "bn_tit_win_1",
    "text": "Victory! Salute me! Lower. Lower. Perfect."
   }
